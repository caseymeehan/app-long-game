# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Session
SESSION_SECRET=generate-a-random-64-character-string

# ThriveCart
THRIVECART_SECRET=your-thrivecart-secret-word
THRIVECART_COURSE_ID=1

# Platform
APP_URL=https://app.long-game.ai
DEFAULT_COURSE_SLUG=ai-for-the-long-game

# MailChimp
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-audience-list-id
MAILCHIMP_DC=us21

# ActiveCampaign (join.blazingzebra.ai opt-in funnel)
# API URL + key: AC Settings -> Developer. IDs are numeric and account-specific;
# AC addresses lists/tags/fields by ID, not by name.
AC_API_URL=https://youraccount.api-us1.com
AC_API_KEY=your-activecampaign-api-key
AC_LIST_ID=3
AC_TAG_ID=1
AC_AFFILIATE_FIELD_ID=2

# Resend (transactional email — masterclass confirmations + coaching application notifications)
RESEND_API_KEY=your-resend-api-key

# Cloudflare Turnstile (captcha for the /one-on-one coaching application form)
# Secret key from the Turnstile widget. If unset, the coaching-application
# route skips captcha verification (the honeypot still applies).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Sentry
# Runtime (set in Railway; DSN is public, the rest are config)
SENTRY_DSN=https://publickey@oNNN.ingest.us.sentry.io/NNN
SENTRY_ENVIRONMENT=production
# Optional override. If unset, both the server and build auto-pick up
# Railway's built-in RAILWAY_GIT_COMMIT_SHA so releases track the commit.
SENTRY_RELEASE=
# Build-only (set in Railway; used by @sentry/vite-plugin to upload sourcemaps)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# For tests
# TEST_DATABASE_URL=postgresql://...
